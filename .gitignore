# build output
build/
app/build/
.gradle/
local.properties
!build/dev/*.kt
!build/dev/*.py
!build/dev/README.md
*.apk
# ...except the release artifacts committed on purpose: the README download links and the GitHub
# releases point at dist/, and a "raw" link only works for files that are in the repository
!dist/*.apk
*.aab
*.dex
*.class
*.jar
# the Gradle wrapper jar is a checked-in binary by design
!gradle/wrapper/gradle-wrapper.jar
__pycache__/
